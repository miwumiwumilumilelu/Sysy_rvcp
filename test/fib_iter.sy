int main() {
    int n = 10;
    int a = 0;
    int b = 1;
    int i = 0;
    int t = 0;

    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }

    i = 2;
    while (i <= n) {
        t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }

    return b; // 55 (Fib(10))
}