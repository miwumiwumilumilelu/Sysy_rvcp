int matA[2][3] = {{1, 2, 3}, {4, 5, 6}};
float matB[2][3] = {{1.0, 1.5, 2.0}, {2.5, 3.0, 3.5}};
float matC[2][3];

int main() {
    int i = 0;
    int j = 0;
    float scalar = 2.5;

    while (i < 2) {
        j = 0;
        while (j < 3) {
            matC[i][j] = matA[i][j] + matB[i][j] * scalar;
            j = j + 1;
        }
        i = i + 1;
    }

    return matC[1][2]; 
}