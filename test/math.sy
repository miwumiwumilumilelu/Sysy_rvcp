int main() {
    int a = 5;
    float b = 2.5;
    int c = 0;
    int res = 0;

    if ((b > 0.0 || a < 0) && !(c == 1)) {
        res = res + 100;
    } else {
        res = res - 100;
    }

    int i = 0;
    while (i < 10 && (a + i < 20 || b < 10.0)) {
        if (!a && !b) {
            res = res - 1;
        } else if (a || c) {
            res = res + 2;
        }
        i = i + 1;
    }

    return res;
}