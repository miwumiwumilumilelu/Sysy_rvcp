// ==========================================
// Part 1: Global Variables
// ==========================================

int g_scalar = 10;

int g_arr[4] = {1, 2};

int g_mat[2][3] = {{1, 2, 3}, {4}};

int sum_n(int arr[], int n) {
    int s = 0;
    int i = 0;
    while (i < n) {
        s = s + arr[i];
        i = i + 1;
    }
    return s;
}

int main() {
    // ==========================================
    // Part 2: Local Variables
    // ==========================================

    int l_arr[3] = {10, 20};

    int l_mat[3][2] = {{1, 2}, {3, 4}};

    // ==========================================
    // Part 3: Verification
    // ==========================================

    int check_g = g_scalar + g_arr[2] + g_mat[1][0] + g_mat[1][2];

    int check_l = l_arr[1] + l_arr[2] + l_mat[1][1] + l_mat[2][0];

    // 3
    int sum_g = sum_n(g_arr, 4);
    
    // 30
    int sum_l = sum_n(l_arr, 3);

    // 71
    return check_g + check_l + sum_g + sum_l;
}