int main() {
    int i = 0;
    float sum = 0.0;
    int flag = 1;

    while (i < 100) {
        if (i == 50) {
            i = i + 1;
            continue;
        }
        
        if (i > 90 && flag) {
            break;
        }

        if (i % 2 == 0) {
            sum = sum + i * 1.5;
        } else {
            sum = sum - i;
        }
        i = i + 1;
    }
    
    return sum;
}